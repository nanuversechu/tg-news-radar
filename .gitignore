# The database is local state, not source: it is large, it grows, and it holds
# scraped headlines. Every machine builds its own within a couple of ticks.
radar.db
radar.db-wal
radar.db-shm

__pycache__/
*.py[cod]

# Scratch files from probing feeds by hand
*.xml
*.html

# The published snapshot is generated output. It lives on the gh-pages branch,
# force-pushed as a single commit, so main never accumulates 300 KB a quarter-hour.
docs/

# The published snapshot is source, not scratch
!docs/index.html
